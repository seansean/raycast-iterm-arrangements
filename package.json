{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "iterm-arrangements",
  "title": "iTerm Window Arrangements",
  "description": "List and restore iTerm window arrangements",
  "icon": "command-icon.png",
  "author": "seansean",
  "license": "MIT",
  "categories": [
    "Applications",
    "Developer Tools",
    "Productivity",
    "System"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Open Window Arrangement",
      "description": "List and restore iTerm window arrangements",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.0",
    "@raycast/utils": "^2.3.1",
    "install": "^0.13.0",
    "node-gyp": "^13.0.2",
    "npm": "^11.20.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "bplist-parser": "^0.3.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
